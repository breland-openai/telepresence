FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS tel2-build

RUN apk add --no-cache gcc musl-dev fuse-dev libcap binutils-gold

WORKDIR /go/telepresence
COPY go.mod go.sum .
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY rpc/ rpc/
COPY charts/ charts/
# This ignored input must also be present when BuildKit reads the source directly from Git.
ADD --checksum=sha256:e1d22fd4a24696a48ed62cbc5facd39b3ff64293f8605b0dc6e7df0f32ed0c40 --chmod=0644 https://raw.githubusercontent.com/yannh/kubernetes-json-schema/a6f9a32d2ccb64b6e4f5b41419b9c2e8ee0cce18/v1.37.1-standalone/_definitions.json charts/telepresence-oss/k8s-defs.json

ARG TARGETOS
ARG TARGETARCH
ARG TELEPRESENCE_VERSION

# TEL_COVER is "-cover" when the image is built with `make tel2-image
# TELEPRESENCE_COVER=1`, and empty (today's behavior) otherwise.
ARG TEL_COVER=

RUN \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    test -n "$TELEPRESENCE_VERSION" && \
    test "$(go list -m -f '{{.Version}}' k8s.io/client-go)" = v0.37.1 && \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build $TEL_COVER -o /usr/local/bin/ -trimpath -ldflags="-s -w -X=$(go list ./pkg/version).Version=$TELEPRESENCE_VERSION" ./cmd/traffic/...

# The tel2 target is the one that gets published. It aims to be a small as possible.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS tel2

RUN apk add --no-cache ca-certificates

# the traffic binary
COPY --from=tel2-build /usr/local/bin/traffic /usr/local/bin

RUN \
  mkdir /tel_app_mounts && \
  chgrp -R 0 /tel_app_mounts && \
  chmod -R g=u /tel_app_mounts && \
  mkdir -p /home/telepresence && \
  chgrp -R 0 /home/telepresence && \
  chmod -R g=u /home/telepresence && \
  chmod 0777 /home/telepresence

ENTRYPOINT ["traffic"]
CMD []
