# Match go.mod: encoding/json/v2 agent-config formats can change across Go releases.
FROM --platform=$BUILDPLATFORM golang:1.26.3-alpine@sha256:91eda9776261207ea25fd06b5b7fed8d397dd2c0a283e77f2ab6e91bfa71079d as tel2-build

ENV GOEXPERIMENT=jsonv2

RUN apk add --no-cache gcc musl-dev fuse-dev libcap binutils-gold

WORKDIR telepresence
COPY go.mod go.sum .
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY rpc/ rpc/

ARG TARGETOS
ARG TARGETARCH

# TEL_COVER is "-cover" when the image is built with `make tel2-image
# TELEPRESENCE_COVER=1`, and empty (today's behavior) otherwise.
ARG TEL_COVER=
# The version is a build input rather than an ignored file in the source checkout.
# Accept release tags both with and without their leading v.
ARG TELEPRESENCE_VERSION

RUN \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    case "$TELEPRESENCE_VERSION" in \
      v2.?*) version="$TELEPRESENCE_VERSION" ;; \
      2.?*) version="v$TELEPRESENCE_VERSION" ;; \
      *) echo "TELEPRESENCE_VERSION must be a v2 release" >&2; exit 1 ;; \
    esac && \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build $TEL_COVER -o /usr/local/bin/ -trimpath -ldflags="-s -w -X=$(go list ./pkg/version).Version=$version" ./cmd/traffic/...

# The tel2 target is the one that gets published. It aims to be a small as possible.
FROM alpine as tel2

RUN apk add --no-cache ca-certificates

# the traffic binary
COPY --from=tel2-build /usr/local/bin/traffic /usr/local/bin

RUN \
  mkdir /tel_app_mounts && \
  chgrp -R 0 /tel_app_mounts && \
  chmod -R g=u /tel_app_mounts && \
  mkdir -p /home/telepresence && \
  chgrp -R 0 /home/telepresence && \
  chmod -R g=u /home/telepresence && \
  chmod 0777 /home/telepresence

ENTRYPOINT ["traffic"]
CMD []
